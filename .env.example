# ============================================================
#  ADHYA Website — Environment Variables Template
#  Copy this file to .env in frontend/ and backend/ folders
#  NEVER commit real .env files to GitHub
# ============================================================

# --- Frontend (prefix with VITE_ so Vite exposes them) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
VITE_API_URL=http://localhost:8000

# --- Backend ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Email (Gmail SMTP — use App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
NOTIFICATION_EMAIL=contact@adhyacreations.com

# CORS — set to your Vercel domain after deployment
FRONTEND_URL=https://adhya.vercel.app
